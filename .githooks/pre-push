#!/bin/sh

# Evita push directo a main (regla local, se refuerza con PRs en GitHub).
# Flujo: feature/* -> develop -> main (vía Pull Request).

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo ""
  echo "BLOCKED: No se permite push directo a la rama 'main'."
  echo "Crea una rama (git switch -c feature/descripcion) y sube cambios por Pull Request."
  exit 1
fi
exit 0
